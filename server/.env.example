# 🔌 MongoDB Atlas connection string (free M0 cluster is enough)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/upi_analyzer
# 🗝️ any long random string
JWT_SECRET=change-me-to-a-long-random-string
PORT=8000
# 🌐 comma separated frontend URLs
CORS_ORIGINS=http://localhost:5173,https://upi-analyzer.vercel.app
