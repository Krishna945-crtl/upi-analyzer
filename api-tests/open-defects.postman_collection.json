        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Auth scheme is case-insensitive (RFC 7235)\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
