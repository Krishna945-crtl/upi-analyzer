{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-000000000002",
    "name": "UPI Analyzer API — Open Defects",
    "description": "One request per logged defect (see BUG_REPORTS.md). Each asserts the EXPECTED behaviour, so it FAILS while the bug is open and passes once it is fixed. Not part of the CI run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "bugEmail1",
      "value": ""
    },
    {
      "key": "bugEmail2",
      "value": ""
    },
    {
      "key": "bugEmail3",
      "value": ""
    },
    {
      "key": "bugEmail4",
      "value": ""
    },
    {
      "key": "longName",
      "value": ""
    },
    {
      "key": "bugToken",
      "value": ""
    },
    {
      "key": "oddToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "BUG-01 One-character password is accepted",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Weak\",\n  \"email\": \"{{bugEmail1}}\",\n  \"password\": \"1\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"bugEmail1\", `weak.${Date.now()}@test.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));pm.test(\"Error mentions password length\", () => pm.expect(pm.response.json().detail || \"\").to.match(/password/i));"
            ]
          }
        }
      ]
    },
    {
      "name": "BUG-02 Numeric password crashes the server (500)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Num\", \"email\": \"{{bugEmail2}}\", \"password\": 123456}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"bugEmail2\", `num.${Date.now()}@test.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Not a server error\", () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "BUG-03 No maximum length on name (5,000 chars accepted)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{longName}}\",\n  \"email\": \"{{bugEmail3}}\",\n  \"password\": \"Secret@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"longName\", \"N\".repeat(5000));",
              "pm.collectionVariables.set(\"bugEmail3\", `long.${Date.now()}@test.com`);"
