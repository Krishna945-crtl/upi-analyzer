    {
      "name": "BUG-05 Negative amount is silently saved as 0",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bugToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactions\": [\n    {\n      \"date\": \"01/03/2026\",\n      \"description\": \"REFUND\",\n      \"debit\": -500\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// fresh user for the defect run",
              "pm.sendRequest({ url: pm.environment.get(\"baseUrl\") + \"/auth/register\", method: \"POST\",",
              "  header: { \"Content-Type\": \"application/json\" },",
              "  body: { mode: \"raw\", raw: JSON.stringify({ name: \"Bug\", email: `bug.${Date.now()}@test.com`, password: \"Secret@123\" }) }",
              "}, (err, res) => pm.collectionVariables.set(\"bugToken\", res.json().token));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Negative amount is rejected (422) instead of being zeroed\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
