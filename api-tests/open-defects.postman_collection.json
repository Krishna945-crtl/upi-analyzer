        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Spaced\",\n  \"email\": \" {{bugEmail4}} \",\n  \"password\": \"Secret@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
