    {
      "name": "BUG-08 Valid token with a non-ObjectId user id crashes (500)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{oddToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b64url = w => CryptoJS.enc.Base64.stringify(w).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const sign = (payload, secret) => {",
              "  const head = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
              "  const body = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
              "  return `${head}.${body}.${b64url(CryptoJS.HmacSHA256(`${head}.${body}`, secret))}`;",
              "};",
              "",
              "// needs the dev/test JWT secret (environment variable jwtSecret)",
              "pm.collectionVariables.set(\"oddToken\", sign({ sub: \"not-an-object-id\" }, pm.environment.get(\"jwtSecret\")));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Not a server error\", () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "BUG-09 Lower-case 'bearer' scheme is rejected",
