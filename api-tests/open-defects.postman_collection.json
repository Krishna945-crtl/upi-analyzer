        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactions\": [\n    {\n      \"date\": \"01/03/2026\",\n      \"description\": \"BOTH\",\n      \"debit\": 100,\n      \"credit\": 200\n    }\n  ]\n}"
        }
